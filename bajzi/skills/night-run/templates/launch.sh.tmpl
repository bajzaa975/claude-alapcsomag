#!/usr/bin/env bash
# launch.sh.tmpl - rendered by /bajzi:night-run PHASE C to <NIGHT_DIR>/launch.sh on EVERY plan,
# overwriting the previous one. The night-run session runs it in PHASE E on the owner's go
# (fallback: the owner, from a plain bash terminal): `bash {{NIGHT_DIR}}/launch.sh`.
#
# Placeholders (all six are substituted at render time, none may survive):
#   {{PROJECT}}    config.env PROJECT
#   {{BASE}}       config.env BASE, the absolute checkout the run works from
#   {{NIGHT_DIR}}  config.env NIGHT_DIR, absolute
#   {{RUN_SH}}     absolute path of run.sh in the plugin copy that ran the skill:
#                  ${CLAUDE_PLUGIN_ROOT}/skills/night-run/run.sh, resolved at every render
#   {{DEADLINE}}   the hard stop, absolute "YYYY-MM-DD HH:MM" in the run machine's local time
#                  (never a bare HH:MM: a relaunch after midnight would roll it to the next day)
#   {{RUN_DATE}}   the night being planned, YYYY-MM-DD: pinned with --date so a relaunch after
#                  local midnight continues the same night's state file
#
# Starts the {{PROJECT}} night run. Kill switch any time: touch {{NIGHT_DIR}}/STOP
set -u
ND="{{NIGHT_DIR}}"
BASE="{{BASE}}"
cd "$BASE" || { echo "cannot cd to $BASE"; exit 1; }
[ -f "{{RUN_SH}}" ] || { echo "run.sh not found: {{RUN_SH}} - re-run /bajzi:night-run so launch.sh is rendered again"; exit 1; }
mkdir -p "$BASE/.claude" "$ND/logs"
# One runner per project: the runner holds flock(2) on run.flock for the whole run.
exec 9>>"$ND/run.flock"
if ! flock -n 9; then echo "A runner is ALREADY running (run.lock: $(cat "$ND/run.lock" 2>/dev/null)). Not starting a second one."; exit 1; fi
flock -u 9; exec 9>&-
# Step 1: install the night allowlist, backing up the existing settings first.
DEST="$BASE/.claude/settings.local.json"
if [ -e "$DEST" ] && ! cp -a "$DEST" "$DEST.pre-night-$(date +%F-%H%M%S)"; then
  echo "BACKUP FAILED — nothing was overwritten"; exit 1
fi
cp "$ND/settings.local.json" "$DEST" || { echo "cannot install $ND/settings.local.json"; exit 1; }
ls -l "$BASE/.claude/"
# Step 2: start the runner, detached (setsid: the launching session's process group dying must not kill it).
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=3600000
# Run from a Claude session's Bash tool this shell carries that session's provider env; the runner, its
# stories and the triage ticks must not inherit it (same set supervise.sh scrubs: the provider env plus the session identity
# - CLAUDE_CODE_SESSION_ID would make `worker` read the planning session's level file; explicit names, owner-set CLAUDE_CODE_* survive).
for v in $(compgen -e); do
  case "$v" in ANTHROPIC_*|CC_ROUTER_*|CC_WORKER_MODE|CLAUDE_CODE_SUBAGENT_MODEL|CLAUDECODE|CLAUDE_CODE_SESSION_ID|CLAUDE_CODE_BRIDGE_SESSION_ID|CLAUDE_CODE_MESSAGING_SOCKET|CLAUDE_CODE_MESSAGING_TOKEN|CLAUDE_CODE_CHILD_SESSION|CLAUDE_CODE_SESSION_ATTENDED|CLAUDE_CODE_ENTRYPOINT|CLAUDE_CODE_EXECPATH|CLAUDE_PID|CLAUDE_EFFORT|BAJZI_SESSION_LEVEL) unset "$v";; esac
done
setsid nohup bash "{{RUN_SH}}" --config "$ND/config.env" --deadline "{{DEADLINE}}" --date "{{RUN_DATE}}" >> "$ND/logs/console.log" 2>&1 </dev/null &
echo "launched, waiting 10 s for the first log lines..."
sleep 10
tail -4 "$ND/logs/runner.log" 2>/dev/null || { echo "no runner.log yet - console.log says:"; tail -5 "$ND/logs/console.log"; }
