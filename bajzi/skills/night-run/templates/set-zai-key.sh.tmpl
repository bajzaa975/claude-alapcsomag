#!/usr/bin/env bash
# Stores the Z.ai (GLM) API key for the bajzi worker/glm launchers in ~/.claude/cc-router.env.
# Rendered by /bajzi:night-run PHASE A step 8 (b). The OWNER runs it, from a plain bash terminal on
# the night machine:  bash {{NIGHT_DIR}}/set-zai-key.sh
# Idempotent: a re-run replaces the stored key. It never changes the saver level.
set -euo pipefail
NIGHT_DIR='{{NIGHT_DIR}}'

# read-secret.sh: the newest bajzi-infra copy in the plugin cache (version-sorted), else $NIGHT_DIR.
shopt -s nullglob
cands=("$HOME"/.claude/plugins/cache/*/bajzi-infra/*/skills/secure-passphrase-prompt/scripts/read-secret.sh)
shopt -u nullglob
rs=""
if [ "${#cands[@]}" -gt 0 ]; then   # sort on the version directory only, never on the marketplace name
  rs=$(for c in "${cands[@]}"; do v=${c%/skills/secure-passphrase-prompt/scripts/read-secret.sh}; printf '%s\t%s\n' "${v##*/}" "$c"; done | sort -V | tail -1 | cut -f2-)
fi
if [ -z "$rs" ] && [ -f "$NIGHT_DIR/read-secret.sh" ]; then rs="$NIGHT_DIR/read-secret.sh"; fi
if [ -z "$rs" ]; then
  echo "read-secret.sh not found: looked in ~/.claude/plugins/cache/*/bajzi-infra/*/skills/secure-passphrase-prompt/scripts/read-secret.sh and $NIGHT_DIR/read-secret.sh" >&2
  exit 1
fi
. "$rs"

# An API key is re-issuable, not an unrecoverable passphrase: no vault gate.
read_secret_from_user --purpose 'the Z.ai GLM API key' --min-length 20 --no-vault-gate || exit 1
umask 077
mkdir -p "$HOME/.claude"
# Atomic: every other line (e.g. DEEPSEEK_API_KEY) is kept, only the Z.ai key line is replaced.
envf="$HOME/.claude/cc-router.env"
tmpf=$(mktemp "$envf.XXXXXX")
chmod 600 "$tmpf"
{ if [ -f "$envf" ]; then grep -Ev '^[[:space:]]*(export[[:space:]]+)?ZAI_API_KEY[[:space:]]*=' "$envf" || :; fi
  printf 'ZAI_API_KEY=%s\n' "$SECRET"; } > "$tmpf"
mv -f "$tmpf" "$envf"
unset SECRET

w="$HOME/.local/bin/worker"
[ -x "$w" ] || w=$(command -v worker) || { echo "key stored; worker not found - run bash <plugin root>/bin/install.sh" >&2; exit 1; }
"$w" --status | grep -E '^(level|ZAI_API_KEY)[[:space:]]'
