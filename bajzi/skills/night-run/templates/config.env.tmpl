# config.env — every project fact the shared night runner needs.
# Rendered per project to ~/night-runs/<project>/config.env and passed to the
# runner with `--config` (or the NIGHT_CONFIG environment variable).
#
# IT IS SOURCED BY BASH (`. config.env`), so:
#   * QUOTE every value that can contain a space: GIT_USER_NAME="Jane Smith".
#     Unquoted, bash reads `GIT_USER_NAME=Jane Smith` as "run the command Smith
#     with GIT_USER_NAME=Jane in its environment", and the runner then refuses
#     to start with the misleading error `missing required field(s):
#     GIT_USER_NAME` — while the field is right there in the file.
#   * NO command substitution and no backticks: `$(...)`, `${...}` and a
#     backtick in any of these values would run as shell, and the value is
#     interpolated into every story prompt. The runner refuses such a value.
#   * One line per value. A newline inside a value is refused too.
# Every field below is REQUIRED and the runner refuses to start if one is empty,
# EXCEPT the few marked "optional (default: ...)", which the runner fills in.

# Short project name; used in prompts, logs and the report. Must match the name
# the Brain knows (`brain next <project>`).
PROJECT="<project>"

# The run's own state directory: queue.txt, BRIEF.md, the per-story briefs
# BRIEF-<id>.md, state-<date>.txt (with state.txt as a symlink to the newest
# one), run.lock, worktrees.tsv, wt/, logs/, REPORT-<date>.md, STOP.
# Must already exist.
NIGHT_DIR="/home/ubuntu/night-runs/<project>"

# The base worktree every story session is STARTED FROM (its cwd), and where
# the generated allowlist is installed as $BASE/.claude/settings.local.json.
# The runner refuses to start if that allowlist is missing, because without it
# every story stalls on a permission prompt until its timeout expires.
# Never a deployed tree. Must already exist.
BASE="/home/ubuntu/<project>-night"

# GitHub repo in owner/name form; used for `gh pr view` dependency gating,
# `gh pr list` in the report, and the story prompt. `gh` must be authenticated
# for this repo: if it cannot answer whether a PR is merged, every gated story
# is BLOCKED (never silently treated as "not merged yet").
REPO="<owner>/<repo>"

# The branch stories start from (origin/<BASE_BRANCH>) and merge back into.
BASE_BRANCH="main"

# Model id for the per-story ORCHESTRATOR session. Each story picks its own
# sub-agent models itself, per the model policy in the rendered BRIEF.
# claude-opus-5-5 — the orchestrator is Opus 5.5; Fable is not used.
MODEL="claude-opus-5-5"

# Hard per-story cap in whole seconds (minimum 60): a hung story can never eat
# the night. The runner enforces it with `timeout -k 60`, so a session that
# ignores SIGTERM is SIGKILLed a minute later, and it CLAMPS this cap to the
# run's --deadline, so the last story of the night gets only the time that is
# actually left. 10800 = 3 h.
PER_STORY_TIMEOUT="10800"

# Branch name prefix: branches are feat/<BRANCH_PREFIX>-<id>-<slug>.
# Must be [A-Za-z0-9._-] — it becomes part of a git branch name.
BRANCH_PREFIX="<prefix>"

# Minimum free disk in GB on the BASE filesystem. The runner refuses to start
# below it and stops before the next story if it drops below it mid-run. A `df`
# that cannot be read counts as "below the floor", never as "unknown, carry on".
DISK_FLOOR_GB="20"

# The NAME of the CI check that must be green before a story may merge. Only a
# pull_request-event run of it counts; the story prompt says so verbatim.
REQUIRED_CHECK="<name of the required check>"

# Git commit identity every story is pinned to. A fresh worktree may inherit no
# user.name/user.email at all, and the story's first commit would then fail, so
# these are mandatory: the runner substitutes them into the per-story brief
# ({{GIT_USER_NAME}} / {{GIT_USER_EMAIL}}) and exports them to the session.
# QUOTE THEM — a real name has a space in it. An apostrophe is fine (the runner
# escapes it for the `git -c user.name=...` command it hands to the session).
GIT_USER_NAME="<commit author name>"
GIT_USER_EMAIL="<commit author email>"

# Optional (default: 45, minimum 1). How many minutes a story may wait for CI
# IN TOTAL before it stops waiting and parks the PR. Substituted into the brief
# as {{CI_WAIT_MINUTES}}; raise it only for a genuinely slow pipeline. 0 is
# refused: it would park every story on its first CI poll.
# CI_WAIT_MINUTES="45"

# Optional (default: 900). How often the watchdog (night-watch.sh) checks that
# the runner is still alive, in seconds. It tests liveness with `flock -n` on
# $NIGHT_DIR/run.flock — the kernel releases that lock the moment the runner
# dies — and a dead runner with no $NIGHT_DIR/finished file is re-launched from
# the complete argv in $NIGHT_DIR/run.args. The runner also touches
# $NIGHT_DIR/heartbeat at least once a minute; a live runner whose heartbeat is
# over 180 s old is reported as STALLED (never restarted — it still holds the
# lock).
# 0 turns the watchdog off completely — then nothing restarts a run that is
# killed at 2am. Only a queue run is watched: --report and --smoke spawn no
# watchdog and publish no run.args/run.meta/finished at all, so they can never
# make a watcher give up on a queue run that died.
# WATCH_INTERVAL="900"

# Optional (default: 2). How many times the watchdog may restart the run in one
# night before it gives up and only reports. It is a bound, not a target: a run
# that keeps dying has a cause the restart cannot fix. The count is kept in the
# WATCHER'S MEMORY — it outlives every runner it restarts, so it is the only
# thing that can hold the budget: the restarted run.sh deletes
# $NIGHT_DIR/watch.restarts at queue start (as it does `finished`) and writes a
# new started_epoch seconds later. That file is a crash hint only, read once
# when a watcher starts and only when it is newer than the run.
# WATCH_MAX_RESTARTS="2"

# Optional (default: none). A command the watchdog calls with ONE argument, the
# message, on every status CHANGE (OK -> STALLED, QUOTA-WAIT, DISK-LOW,
# RESTARTED, DEAD, FINISHED …) and on every restart. Anything that takes a string works —
# a script, `notify-send`, a curl wrapper. Empty = no notification.
# QUOTE IT, and do not put the message in it: the watcher appends it.
# WATCH_NOTIFY_CMD="/home/ubuntu/bin/notify.sh"

# Optional (default: 180). Seconds added to the reset time the model announces
# ("resets 5:50am (UTC)") before the runner starts another session. The clocks
# are not the same clock; retrying at the announced second just spends the
# story on a second limit message. It is applied ONCE, by run.sh, when it writes
# $NIGHT_DIR/quota-until — that file is the exact moment launches may resume and
# the watchdog adds nothing to it.
# QUOTA_MARGIN_SEC="180"

# Optional (default: 3). How many usage-limit waits ONE run may take. When the
# limit is hit more times than this, the run finishes and reports instead of
# spending the night asleep. The DEFERRED-quota rows stay non-terminal, so the
# next night's queue picks those stories up.
# QUOTA_MAX_WAITS="3"

# Optional (default: 1800). Seconds to wait when the limit message carries a
# reset time the runner cannot parse (the reason column then reads
# `resets=unknown`). Never 0: retrying immediately just burns the queue.
# QUOTA_FALLBACK_WAIT_SEC="1800"

# Optional (default: 21600 = 6 h). The longest a SINGLE usage-limit wait may
# be. QUOTA_MAX_WAITS bounds HOW MANY waits a run takes; this bounds how long
# one of them can last. A reset that resolves a day out — a clock skew, or a
# limit that really does reset tomorrow — would otherwise hold $NIGHT_DIR/
# run.flock, and with it the whole project, for that day with nothing running
# and no report until it ended. When the computed wait is longer, the runner
# logs `QUOTA-WAIT refused — <n> min exceeds QUOTA_MAX_WAIT_SEC`, leaves the
# rows DEFERRED-quota (non-terminal, so the next night re-queues those
# stories), writes the report and finishes.
# QUOTA_MAX_WAIT_SEC="21600"

# ---------------------------------------------------------------------------
# Filled-in example — innotel-bss, from the constants of the proven
# /home/ubuntu/night/run.sh (2026-09-17 and 2026-09-18 runs):
#
# PROJECT="innotel-bss"
# NIGHT_DIR="/home/ubuntu/night-runs/innotel-bss"
# BASE="/home/ubuntu/bss-night"
# REPO="bajzaa975/innotel-bss"
# BASE_BRANCH="dev"
# MODEL="claude-opus-5-5"
# PER_STORY_TIMEOUT="10800"
# BRANCH_PREFIX="bss"
# DISK_FLOOR_GB="20"
# GIT_USER_NAME="bajzaa975"          # quote it even when it has no space, so
# GIT_USER_EMAIL="andras.bajza@gmail.com"   # "Bajza Andras" keeps working
# CI_WAIT_MINUTES="45"
# REQUIRED_CHECK="CI"               # only its pull_request-event run counts;
#                                   # workflow name "CI" (.github/workflows/ci.yml);
#                                   # `gh pr checks` fails with the configured
#                                   # token, so read it with
#                                   # `gh run list -R bajzaa975/innotel-bss --event
#                                   #  pull_request --json name,conclusion,headBranch`
# ---------------------------------------------------------------------------
