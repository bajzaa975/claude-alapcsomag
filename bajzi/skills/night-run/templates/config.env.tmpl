# config.env — every project fact the shared night runner needs.
# Rendered per project to ~/night-runs/<project>/config.env and passed to the
# runner with `--config` (or the NIGHT_CONFIG environment variable).
# It is sourced by bash: plain KEY=value lines, no command substitution.
# Every field below is REQUIRED and the runner refuses to start if one is empty,
# EXCEPT the few marked "optional (default: ...)", which the runner fills in.

# Short project name; used in prompts, logs and the report. Must match the name
# the Brain knows (`brain next <project>`).
PROJECT=<project>

# The run's own state directory: queue.txt, BRIEF.md, state.txt, run.lock,
# worktrees.tsv, wt/, logs/, REPORT-<date>.md, STOP. Must already exist.
NIGHT_DIR=/home/ubuntu/night-runs/<project>

# The base worktree every story session is STARTED FROM (its cwd), and where
# the generated allowlist is installed as $BASE/.claude/settings.local.json.
# Never a deployed tree. Must already exist.
BASE=/home/ubuntu/<project>-night

# GitHub repo in owner/name form; used for `gh pr view` dependency gating,
# `gh pr list` in the report, and the story prompt.
REPO=<owner>/<repo>

# The branch stories start from (origin/<BASE_BRANCH>) and merge back into.
BASE_BRANCH=main

# Model id for the per-story ORCHESTRATOR session. Each story picks its own
# sub-agent models itself, per the model policy in the rendered BRIEF.
# claude-fable-5-1 normally; claude-opus-5 when the Fable budget is used up.
MODEL=claude-fable-5-1

# Hard per-story cap in whole seconds: a hung story can never eat the night.
# 10800 = 3 h.
PER_STORY_TIMEOUT=10800

# Branch name prefix: branches are feat/<BRANCH_PREFIX>-<id>-<slug>.
BRANCH_PREFIX=<prefix>

# Minimum free disk in GB on the BASE filesystem. The runner refuses to start
# below it and stops before the next story if it drops below it mid-run.
DISK_FLOOR_GB=20

# The NAME of the CI check that must be green before a story may merge. Only a
# pull_request-event run of it counts; the story prompt says so verbatim.
REQUIRED_CHECK=<name of the required check>

# Git commit identity every story is pinned to. A fresh worktree may inherit no
# user.name/user.email at all, and the story's first commit would then fail, so
# these are mandatory: the runner substitutes them into the per-story brief
# ({{GIT_USER_NAME}} / {{GIT_USER_EMAIL}}) and exports them to the session.
GIT_USER_NAME=<commit author name>
GIT_USER_EMAIL=<commit author email>

# Optional (default: 45). How many minutes a story may wait for CI IN TOTAL
# before it stops waiting and parks the PR. Substituted into the brief as
# {{CI_WAIT_MINUTES}}; raise it only for a genuinely slow pipeline.
# CI_WAIT_MINUTES=45

# ---------------------------------------------------------------------------
# Filled-in example — innotel-bss, from the constants of the proven
# /home/ubuntu/night/run.sh (2026-09-17 and 2026-09-18 runs):
#
# PROJECT=innotel-bss
# NIGHT_DIR=/home/ubuntu/night-runs/innotel-bss
# BASE=/home/ubuntu/bss-night
# REPO=bajzaa975/innotel-bss
# BASE_BRANCH=dev
# MODEL=claude-fable-5-1
# PER_STORY_TIMEOUT=10800
# BRANCH_PREFIX=bss
# DISK_FLOOR_GB=20
# GIT_USER_NAME=bajzaa975
# GIT_USER_EMAIL=andras.bajza@gmail.com
# CI_WAIT_MINUTES=45
# REQUIRED_CHECK=CI                 # only its pull_request-event run counts;
#                                   # workflow name "CI" (.github/workflows/ci.yml);
#                                   # `gh pr checks` fails with the configured
#                                   # token, so read it with
#                                   # `gh run list -R bajzaa975/innotel-bss --event
#                                   #  pull_request --json name,conclusion,headBranch`
