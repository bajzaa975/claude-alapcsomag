{
  "_comment": "Deny-list settings for a headless GLM worker launched as: glm -p --permission-mode bypassPermissions --settings <this file>. The auto-mode rule in the setup manifest approves the bypassPermissions launch only together with this file. It is a pattern guard, not a sandbox: Bash rules are wildcard matches on the command text (leading and trailing * so the bare, /usr/bin and -C <dir> spellings all match) and can be evaded by a determined command. git add and git commit stay allowed so the worker can commit on its own branch.",
  "permissions": {
    "deny": [
      "Bash(*git*push*)",
      "Bash(*git*reset*--hard*)",
      "Bash(*git*clean*-f*)",
      "Bash(*git*clean*-x*)",
      "Bash(*git*rebase*)",
      "Bash(*git*branch*-D*)",
      "Bash(*git*branch*-d*)",
      "Bash(*git*filter-branch*)",
      "Bash(*git*update-ref*)",
      "Bash(*git*stash*)",
      "Bash(*git*worktree*remove*)",
      "Bash(*git*worktree*prune*)",
      "Bash(*gh*pr*merge*)",
      "Bash(*gh*release*)",
      "Bash(*gh*repo*delete*)",
      "Bash(*gh*api*-X*DELETE*)",
      "Bash(*npm*publish*)",
      "Bash(*claude*plugin*)",
      "Bash(*claude*mcp*)",
      "Bash(*sudo*)",
      "Bash(*pkill*)",
      "Bash(*killall*)",
      "Bash(*kill*-9*)",
      "Bash(*kill*-KILL*)",
      "Bash(*taskkill*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production*)",
      "Read(.env.development*)",
      "Read(.env.test*)",
      "Read(.env.staging*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.production*)",
      "Edit(.env.development*)",
      "Edit(.env.test*)",
      "Edit(.env.staging*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/bajzi/**)"
    ]
  }
}
