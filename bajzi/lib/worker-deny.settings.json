{
  "_comment": "Deny-list settings for a headless GLM worker launched as: glm -p --permission-mode bypassPermissions --settings <this file>. The auto-mode rule in the setup manifest approves the bypassPermissions launch only together with this file. It is a pattern guard, not a sandbox: Bash rules are wildcard matches on the command text in the night-run template's literal-space form (*git push*, plus an explicit *git -C * push* variant, so the bare, /usr/bin and -C <dir> spellings match while git add and git commit do not) and can be evaded by a determined command. git add and git commit stay allowed so the worker can commit on its own branch. MEASURED 2026-11-24: under bypassPermissions a Read(~/.ssh/**) rule did NOT stop 'cat ~/.ssh/config' run through Bash, so the secret paths and the .env family are also denied as Bash text patterns at the end of the list (.env.example stays readable).",
  "permissions": {
    "deny": [
      "Bash(*git push*)",
      "Bash(*git -C * push*)",
      "Bash(*git reset --hard*)",
      "Bash(*git -C * reset --hard*)",
      "Bash(*git clean -f*)",
      "Bash(*git -C * clean -f*)",
      "Bash(*git clean -x*)",
      "Bash(*git -C * clean -x*)",
      "Bash(*git rebase*)",
      "Bash(*git -C * rebase*)",
      "Bash(*git branch -D*)",
      "Bash(*git -C * branch -D*)",
      "Bash(*git branch -d*)",
      "Bash(*git -C * branch -d*)",
      "Bash(*git filter-branch*)",
      "Bash(*git -C * filter-branch*)",
      "Bash(*git update-ref*)",
      "Bash(*git -C * update-ref*)",
      "Bash(*git stash*)",
      "Bash(*git -C * stash*)",
      "Bash(*git worktree remove*)",
      "Bash(*git -C * worktree remove*)",
      "Bash(*git worktree prune*)",
      "Bash(*git -C * worktree prune*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh release*)",
      "Bash(*gh repo delete*)",
      "Bash(*gh api*-X DELETE*)",
      "Bash(*npm publish*)",
      "Bash(*claude plugin *)",
      "Bash(*claude mcp *)",
      "Bash(sudo *)",
      "Bash(* sudo *)",
      "Bash(*/sudo *)",
      "Bash(*pkill *)",
      "Bash(*killall *)",
      "Bash(*kill -9*)",
      "Bash(*kill -KILL*)",
      "Bash(*taskkill*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production*)",
      "Read(.env.development*)",
      "Read(.env.test*)",
      "Read(.env.staging*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.production*)",
      "Edit(.env.development*)",
      "Edit(.env.test*)",
      "Edit(.env.staging*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/bajzi/**)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(*.env.local*)",
      "Bash(*.env.*.local*)",
      "Bash(*.env.production*)",
      "Bash(*.env.development*)",
      "Bash(*.env.test*)",
      "Bash(*.env.staging*)",
      "Bash(*.ssh/*)",
      "Bash(*.ssh *)",
      "Bash(*.aws/*)",
      "Bash(*.config/gh*)",
      "Bash(*.credentials.json*)"
    ]
  }
}
