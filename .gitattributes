# A hook shell-script MINDIG LF sorvéggel kerüljön ki, Windows-on is —
# CRLF-fel a bash "bad interpreter" hibával elszáll.
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
bajzi/bin/**/*.js text eol=lf
bajzi/hooks/node/**/*.js text eol=lf
bajzi/skills/**/*.js text eol=lf
# Launchers ship byte-for-byte (bash ones LF, .cmd twins CRLF): no eol conversion at all.
bajzi/bin/launchers/** -text
bajzi/gate/**/*.js text eol=lf
